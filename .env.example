# Required for public management API. Fill with a long random value.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# If the value contains $, wrap the entire value in single quotes for Compose.
# 网页访问密钥，必填
TG_IFTTT_ADMIN_TOKEN=

# adapter: fake is safe for an offline smoke test. Production choices:
TG_IFTTT_ADAPTER=mtproto
TG_IFTTT_API_ID=
TG_IFTTT_API_HASH=
# Optional: leave unset to store ordinary-account sessions as plaintext in SQLite.
# TG_IFTTT_MASTER_KEY=64-hex-characters-for-a-32-byte-key
# or:
# TG_IFTTT_ADAPTER=bot_api
# TG_IFTTT_BOT_TOKEN=123456:replace-with-bot-token

# Public ports for the API and the static React console.
TG_IFTTT_API_BIND_PORT=8000
TG_IFTTT_UI_BIND_PORT=8080

# Node-RED is available through http://localhost:8080/nodered/ and port 1880.
# If omitted, its login password falls back to TG_IFTTT_ADMIN_TOKEN.
TG_IFTTT_NODERED_USER=admin
# TG_IFTTT_NODERED_PASSWORD=use-a-different-long-password
# Optional: otherwise TG_IFTTT_MASTER_KEY or TG_IFTTT_ADMIN_TOKEN is used.
# TG_IFTTT_NODERED_CREDENTIAL_SECRET=another-long-stable-secret
TG_IFTTT_NODERED_BIND_PORT=1880

# Background loop intervals in seconds.
TG_IFTTT_RECOVERY_INTERVAL=15
TG_IFTTT_SCHEDULER_INTERVAL=20
TG_IFTTT_EVENT_POLL_INTERVAL=5

# Timezone for fixed-time calendar schedules (defaults to Asia/Shanghai).
# TG_IFTTT_TIMEZONE=Asia/Shanghai

# Optional separate secret for unauthenticated external webhook calls.
# TG_IFTTT_WEBHOOK_SECRET=replace-with-a-second-long-random-token
